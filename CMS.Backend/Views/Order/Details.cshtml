@model CMS.Data.Entities.Order

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold mb-0">
            <i class="fas fa-file-invoice me-2 text-primary"></i> Đơn hàng #@Model.Id
        </h2>
        <div>
            <a asp-action="Invoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-primary rounded-pill px-4 me-2 shadow-sm">
                <i class="fas fa-print me-2"></i> In Hóa Đơn
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
                <i class="fas fa-arrow-left me-2"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột Trái: Thông tin người dùng & Trạng thái -->
        <div class="col-lg-4">
            <!-- Thẻ Khách hàng -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="fas fa-user-circle me-2 text-primary"></i> Thông tin khách hàng</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><span class="text-muted"><i class="fas fa-user me-2"></i> Tên:</span> <strong class="text-dark">@(Model.Customer?.FullName ?? "Khách vãng lai")</strong></p>
                    <p class="mb-2"><span class="text-muted"><i class="fas fa-phone-alt me-2"></i> SĐT:</span> <strong class="text-dark">@(Model.Customer?.Phone ?? "N/A")</strong></p>
                    <p class="mb-2"><span class="text-muted"><i class="fas fa-envelope me-2"></i> Email:</span> <strong class="text-dark">@(Model.Customer?.Email ?? "N/A")</strong></p>
                    <p class="mb-0"><span class="text-muted"><i class="fas fa-map-marker-alt me-2"></i> Địa chỉ:</span> <strong class="text-dark">@(Model.Customer?.Address ?? "Chưa cung cấp")</strong></p>
                </div>
            </div>

            <!-- Thẻ Giao hàng & Ghi chú -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="fas fa-shipping-fast me-2 text-info"></i> Giao hàng & Thanh toán</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><span class="text-muted"><i class="fas fa-calendar-alt me-2"></i> Ngày đặt:</span> <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong></p>
                    <div class="p-3 bg-light rounded-3 text-dark small border">
                        @Html.Raw(Model.Notes?.Replace("\n", "<br/>") ?? "Không có ghi chú")
                    </div>
                </div>
            </div>

            <!-- Thẻ Trạng thái -->
            <div class="card border-0 shadow-sm rounded-4 border-start border-4 border-primary">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold"><i class="fas fa-tasks me-2 text-primary"></i> Trạng thái đơn hàng</h5>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" method="post" class="d-flex flex-column gap-3">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="status" class="form-select fw-bold @(Model.Status == 2 ? "text-success" : Model.Status == -1 ? "text-danger" : "text-primary")">
                            @if(Model.Status == 0) { <option value="0" selected>Chờ duyệt</option> } else { <option value="0">Chờ duyệt</option> }
                            @if(Model.Status == 1) { <option value="1" selected>Đang giao</option> } else { <option value="1">Đang giao</option> }
                            @if(Model.Status == 2) { <option value="2" selected>Hoàn thành</option> } else { <option value="2">Hoàn thành</option> }
                            @if(Model.Status == -1) { <option value="-1" selected>Đã hủy</option> } else { <option value="-1">Đã hủy</option> }
                        </select>
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold shadow-sm">
                            <i class="fas fa-save me-2"></i> Cập nhật
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Danh sách Sản phẩm -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-bottom pt-4 pb-3">
                    <h5 class="fw-bold mb-0"><i class="fas fa-box-open me-2 text-warning"></i> Chi tiết mặt hàng</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 custom-table">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th class="text-center">Đơn giá</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                                {
                                    decimal totalAmount = 0;
                                    foreach (var detail in Model.OrderDetails)
                                    {
                                        decimal lineTotal = detail.UnitPrice * detail.Quantity;
                                        totalAmount += lineTotal;
                                        <tr>
                                            <td class="ps-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    <div class="border rounded me-3 bg-white d-flex align-items-center justify-content-center p-1" style="width: 60px; height: 60px; overflow: hidden;">
                                                        @if (detail.Product != null && !string.IsNullOrEmpty(detail.Product.ImageUrl))
                                                        {
                                                            <img src="@detail.Product.ImageUrl" alt="@detail.Product.Name" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-image text-muted fs-3"></i>
                                                        }
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-1 text-dark fw-bold">@(detail.Product?.Name ?? "Sản phẩm không tồn tại")</h6>
                                                        <div class="text-muted small">ID: #@detail.ProductId</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center text-danger fw-medium">@detail.UnitPrice.ToString("N0")₫</td>
                                            <td class="text-center"><span class="badge bg-light text-dark border px-3 py-2 fs-6">x @detail.Quantity</span></td>
                                            <td class="text-end pe-4 text-danger fw-bold fs-6">@lineTotal.ToString("N0")₫</td>
                                        </tr>
                                    }
                                    <tr class="bg-light">
                                        <td colspan="3" class="text-end fw-bold py-4 fs-5">TỔNG TIỀN THANH TOÁN:</td>
                                        <td class="text-end pe-4 fw-bold fs-4 text-danger py-4">@totalAmount.ToString("N0")₫</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="fas fa-exclamation-circle fs-2 mb-2 d-block"></i>
                                            Không có dữ liệu chi tiết mặt hàng cho đơn này.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body { background: #f8f9fc; }
    .custom-table thead th { font-size: 12px; text-transform: uppercase; color: #6c757d; border-bottom-width: 1px; padding: 12px 15px; }
    .custom-table tbody td { border-bottom: 1px solid #f1f3f5; }
    .custom-table tbody tr:last-child td { border-bottom: none; }
</style>
