@model IEnumerable<CMS.Data.Entities.Order>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>In Hóa Đơn Hàng Loạt</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            color: #333;
            background-color: #fff;
            padding: 40px;
        }
        .invoice-page {
            page-break-after: always;
            margin-bottom: 60px;
            padding-bottom: 40px;
            border-bottom: 2px dashed #ccc;
        }
        .invoice-page:last-child {
            page-break-after: auto;
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        .invoice-header {
            border-bottom: 2px solid #333;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .brand-name {
            font-size: 2.5rem;
            font-weight: 800;
            letter-spacing: -1px;
            color: #111;
        }
        .invoice-title {
            font-size: 2rem;
            font-weight: 300;
            color: #666;
            text-transform: uppercase;
        }
        .info-box {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            height: 100%;
        }
        .table th {
            background-color: #f8f9fa !important;
            border-top: 1px solid #dee2e6;
            color: #555;
            text-transform: uppercase;
            font-size: 0.85rem;
        }
        .total-row td {
            font-size: 1.25rem;
            font-weight: 700;
            border-top: 2px solid #333 !important;
        }
        .print-btn {
            position: fixed;
            bottom: 30px;
            right: 30px;
            border-radius: 50px;
            padding: 15px 30px;
            font-weight: bold;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            z-index: 1000;
        }
        @@media print {
            body { padding: 0; }
            .print-btn { display: none !important; }
            .invoice-page { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
            .info-box { border: 1px solid #ddd; }
        }
    </style>
</head>
<body>

    <button onclick="window.print()" class="btn btn-primary print-btn btn-lg d-print-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-printer-fill me-2" viewBox="0 0 16 16">
            <path d="M5 1a2 2 0 0 0-2 2v1h10V3a2 2 0 0 0-2-2H5zm6 8H5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1z"/>
            <path d="M0 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-1v-2a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v2H2a2 2 0 0 1-2-2V7zm2.5 1a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z"/>
        </svg>
        In Tất Cả
    </button>

    @foreach (var order in Model)
    {
        <div class="invoice-page">
            <div class="container-fluid p-0" style="max-width: 900px; margin: 0 auto;">
                
                <!-- Header -->
                <div class="row align-items-center invoice-header">
                    <div class="col-6">
                        <div class="brand-name">XTRA STORE</div>
                        <div class="text-muted mt-1">Chuyên Phụ Kiện Đồng Hồ Thông Minh</div>
                    </div>
                    <div class="col-6 text-end">
                        <div class="invoice-title">Hóa Đơn Bán Hàng</div>
                        <div class="mt-2"><strong>Mã đơn:</strong> #@order.Id</div>
                        <div><strong>Ngày đặt:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>

                <!-- Customer & Order Info -->
                <div class="row g-4 mb-5">
                    <div class="col-sm-6">
                        <div class="info-box">
                            <h5 class="fw-bold mb-3">Thông tin khách hàng</h5>
                            <div class="mb-1"><strong>Họ tên:</strong> @(order.Customer?.FullName ?? "Khách vãng lai")</div>
                            <div class="mb-1"><strong>SĐT:</strong> @(order.Customer?.Phone ?? "N/A")</div>
                            <div class="mb-1"><strong>Email:</strong> @(order.Customer?.Email ?? "N/A")</div>
                            <div class="mb-0"><strong>Địa chỉ:</strong> @(order.Customer?.Address ?? "Chưa cung cấp")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-box">
                            <h5 class="fw-bold mb-3">Thông tin giao hàng</h5>
                            <div class="mb-3" style="white-space: pre-wrap;">@order.Notes</div>
                        </div>
                    </div>
                </div>

                <!-- Products Table -->
                <div class="table-responsive mb-5">
                    <table class="table table-borderless align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end pe-3">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody class="border-bottom">
                            @if (order.OrderDetails != null && order.OrderDetails.Any())
                            {
                                decimal totalAmount = 0;
                                foreach (var detail in order.OrderDetails)
                                {
                                    decimal lineTotal = detail.UnitPrice * detail.Quantity;
                                    totalAmount += lineTotal;
                                    <tr>
                                        <td class="ps-3 py-3">
                                            <h6 class="mb-0 fw-bold">@(detail.Product?.Name ?? "Sản phẩm không tồn tại")</h6>
                                            <small class="text-muted">Mã SP: #@detail.ProductId</small>
                                        </td>
                                        <td class="text-center">@detail.UnitPrice.ToString("N0")₫</td>
                                        <td class="text-center">@detail.Quantity</td>
                                        <td class="text-end pe-3 fw-medium">@lineTotal.ToString("N0")₫</td>
                                    </tr>
                                }
                                <tr class="total-row">
                                    <td colspan="3" class="text-end py-4">TỔNG CỘNG:</td>
                                    <td class="text-end pe-3 py-4 text-danger">@totalAmount.ToString("N0")₫</td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Không có dữ liệu mặt hàng.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="row mt-5 text-center text-muted" style="font-size: 0.9rem;">
                    <div class="col-12">
                        <p class="mb-1">Cảm ơn quý khách đã tin tưởng và mua sắm tại XTRA Store!</p>
                        <p class="mb-0">Nếu có thắc mắc về đơn hàng, vui lòng liên hệ Hotline: 1900 1234</p>
                    </div>
                </div>

            </div>
        </div>
    }

    <!-- Auto trigger print dialog on load -->
    <script>
        window.onload = function() {
            setTimeout(function() {
                window.print();
            }, 500);
        };
    </script>
</body>
</html>
