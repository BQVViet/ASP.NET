@{
    ViewData["Title"] = "Tổng quan Hệ thống";
    Layout = "_LayoutAdmin";
}

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container-fluid px-0 mt-4 mb-5">
    
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
           
            <p class="text-muted mb-0">Báo cáo hiệu suất kinh doanh và nội dung tháng @DateTime.Now.Month/@DateTime.Now.Year</p>
        </div>
        <div>
            <button class="btn btn-light shadow-sm border-0 px-3 py-2 fw-medium rounded-pill d-flex align-items-center gap-2 text-primary bg-white" onclick="loadDashboardData()">
                <i class="bi bi-arrow-clockwise" id="refresh-icon"></i> Cập nhật dữ liệu
            </button>
        </div>
    </div>

    <!-- STATS CARDS -->
    <div class="row g-4 mb-4">
        <!-- Doanh thu -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden stat-card">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Doanh thu</div>
                        <div class="icon-box bg-primary-soft text-primary">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-2" id="stat-revenue"><i class="fas fa-spinner fa-spin fs-5 text-muted"></i></h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success-soft text-success rounded-pill px-2 py-1"><i class="bi bi-arrow-up-right fw-bold"></i> +12.5%</span>
                        <span class="text-muted" style="font-size: 0.8rem;">So với tháng trước</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Đơn hàng -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden stat-card">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Đơn hàng mới</div>
                        <div class="icon-box bg-success-soft text-success">
                            <i class="bi bi-bag-check"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-2" id="stat-orders"><i class="fas fa-spinner fa-spin fs-5 text-muted"></i></h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success-soft text-success rounded-pill px-2 py-1"><i class="bi bi-arrow-up-right fw-bold"></i> +5.2%</span>
                        <span class="text-muted" style="font-size: 0.8rem;">So với tháng trước</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thành viên -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden stat-card">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Khách hàng</div>
                        <div class="icon-box bg-warning-soft text-warning">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-2" id="stat-customers"><i class="fas fa-spinner fa-spin fs-5 text-muted"></i></h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-danger-soft text-danger rounded-pill px-2 py-1"><i class="bi bi-arrow-down-right fw-bold"></i> -1.2%</span>
                        <span class="text-muted" style="font-size: 0.8rem;">So với tháng trước</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lượt xem -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden stat-card">
                <div class="card-body p-4 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="text-muted fw-bold text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">Lượt truy cập</div>
                        <div class="icon-box bg-info-soft text-info">
                            <i class="bi bi-bar-chart"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-2" id="stat-visits"><i class="fas fa-spinner fa-spin fs-5 text-muted"></i></h3>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success-soft text-success rounded-pill px-2 py-1"><i class="bi bi-arrow-up-right fw-bold"></i> +18.4%</span>
                        <span class="text-muted" style="font-size: 0.8rem;">So với tháng trước</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CHARTS -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">Biểu đồ doanh thu (Thực tế)</h5>
                    <div class="dropdown">
                        <button class="btn btn-light btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" type="button">
                            <i class="bi bi-three-dots-vertical text-muted"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div style="height: 300px;">
                        <canvas id="revenueChart" style="width: 100%; height: 100%;"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">Tỷ lệ danh mục</h5>
                </div>
                <div class="card-body p-4 d-flex justify-content-center align-items-center flex-column" style="min-height: 300px;">
                    <div style="width: 100%; height: 260px; position: relative;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RECENT DATA -->
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="card-header bg-primary text-white border-0 p-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0"><i class="bi bi-cart3 me-2"></i> Đơn hàng gần đây</h5>
                    <a asp-controller="Order" asp-action="Index" class="btn btn-light btn-sm rounded-pill fw-medium text-primary px-3 shadow-sm">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle custom-admin-table mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">MÃ ĐƠN</th>
                                    <th>KHÁCH HÀNG</th>
                                    <th>NGÀY ĐẶT</th>
                                    <th>TỔNG TIỀN</th>
                                    <th class="text-center pe-4">TRẠNG THÁI</th>
                                </tr>
                            </thead>
                            <tbody id="recent-orders-list">
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="fas fa-spinner fa-spin me-2"></i> Đang tải dữ liệu...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">Bài viết mới</h5>
                    <a asp-controller="Post" asp-action="Index" class="text-primary text-decoration-none small fw-bold">Xem tất cả <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3" id="recent-posts-list">
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-spinner fa-spin me-2"></i> Đang tải bài viết...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body { background: #f1f5f9 !important; }
    .icon-box {
        width: 48px; height: 48px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
    }
    .bg-primary-soft { background-color: #e0e7ff; }
    .bg-success-soft { background-color: #d1fae5; }
    .bg-warning-soft { background-color: #fef3c7; }
    .bg-danger-soft { background-color: #fee2e2; }
    .bg-info-soft { background-color: #e0f2fe; }

    .stat-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important; }

    .custom-admin-table { border: none !important; }
    .custom-admin-table thead { background: #fafafa !important; }
    .custom-admin-table thead th {
        color: #4f46e5 !important; font-size: 12px !important; font-weight: 700 !important;
        text-transform: uppercase; letter-spacing: 0.5px; padding: 16px 14px !important;
        border-bottom: 1px solid #e2e8f0 !important;
    }
    .custom-admin-table tbody td {
        padding: 16px 14px !important; border-bottom: 1px solid #f1f5f9 !important; vertical-align: middle;
    }
    .line-clamp-2 {
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
</style>

<script>
    let revChartInstance = null;
    let catChartInstance = null;

    document.addEventListener("DOMContentLoaded", function() {
        loadDashboardData();
    });

    function loadDashboardData() {
        const icon = document.getElementById('refresh-icon');
        icon.classList.add('fa-spin'); // spin animation while loading

        fetch('/Home/GetDashboardData')
            .then(res => res.json())
            .then(res => {
                icon.classList.remove('fa-spin');
                if (res.success) {
                    // Cập nhật số liệu
                    document.getElementById('stat-revenue').innerText = res.stats.revenue.toLocaleString('vi-VN') + ' ₫';
                    document.getElementById('stat-orders').innerText = res.stats.orders.toLocaleString('en-US');
                    document.getElementById('stat-customers').innerText = res.stats.customers.toLocaleString('en-US');
                    document.getElementById('stat-visits').innerText = res.stats.visits.toLocaleString('en-US');

                    // Hiển thị Đơn hàng
                    const tbody = document.getElementById('recent-orders-list');
                    tbody.innerHTML = '';
                    if (res.recentOrders && res.recentOrders.length > 0) {
                        res.recentOrders.forEach(o => {
                            let statusHtml = '';
                            if (o.status === 0) statusHtml = '<span class="badge bg-warning-soft text-warning rounded-pill px-3 py-2">Chờ duyệt</span>';
                            else if (o.status === 1) statusHtml = '<span class="badge bg-info-soft text-info rounded-pill px-3 py-2">Đang giao</span>';
                            else statusHtml = '<span class="badge bg-success-soft text-success rounded-pill px-3 py-2">Đã xong</span>';

                            tbody.innerHTML += `
                                <tr>
                                    <td class="ps-4 fw-bold text-secondary">${o.code}</td>
                                    <td class="fw-bold text-dark">${o.customer}</td>
                                    <td class="text-muted" style="font-size: 0.9rem;">${o.dateText}</td>
                                    <td class="fw-bold text-primary">${o.totalAmount.toLocaleString('vi-VN')} ₫</td>
                                    <td class="text-center pe-4">${statusHtml}</td>
                                </tr>
                            `;
                        });
                    } else {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Chưa có đơn hàng nào</td></tr>';
                    }

                    // Hiển thị Bài viết
                    const postsList = document.getElementById('recent-posts-list');
                    postsList.innerHTML = '';
                    if (res.recentPosts && res.recentPosts.length > 0) {
                        res.recentPosts.forEach(p => {
                            postsList.innerHTML += `
                                <div class="d-flex gap-3 align-items-center pb-3 border-bottom" style="border-color: #f1f5f9 !important;">
                                    <div class="rounded-3 overflow-hidden flex-shrink-0" style="width: 70px; height: 70px; border: 1px solid #e2e8f0;">
                                        <img src="${p.imageUrl}" class="w-100 h-100" style="object-fit: cover;" />
                                    </div>
                                    <div class="d-flex flex-column justify-content-center">
                                        <a href="/Post/Details/${p.id}" class="text-dark fw-bold text-decoration-none d-block line-clamp-2 mb-1" style="font-size: 0.95rem; line-height: 1.3;">${p.title}</a>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-primary-soft text-primary px-2 py-1" style="font-size: 0.7rem;">${p.categoryName}</span>
                                            <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-clock me-1"></i> ${p.dateText}</small>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                    } else {
                        postsList.innerHTML = '<div class="text-center text-muted py-4">Chưa có bài viết nào</div>';
                    }

                    // Render Charts
                    initCharts(res.charts);
                } else {
                    alert("Lỗi khi tải dữ liệu: " + res.message);
                }
            })
            .catch(err => {
                icon.classList.remove('fa-spin');
                console.error("Fetch Error:", err);
            });
    }

    function initCharts(chartData) {
        if (revChartInstance) revChartInstance.destroy();
        if (catChartInstance) catChartInstance.destroy();

        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        const gradient = ctxRev.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(79, 70, 229, 0.25)');
        gradient.addColorStop(1, 'rgba(79, 70, 229, 0.0)');

        revChartInstance = new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: ['Tuần 1', 'Tuần 2', 'Tuần 3', 'Tuần 4', 'Tuần 5', 'Tuần 6', 'Hiện tại'],
                datasets: [{
                    label: 'Doanh thu (Triệu VNĐ)',
                    data: chartData.revenueData,
                    borderColor: '#4f46e5',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#4f46e5',
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b', padding: 12,
                        titleFont: { size: 13, family: 'Inter' },
                        bodyFont: { size: 14, weight: 'bold', family: 'Inter' },
                        displayColors: false
                    }
                },
                scales: {
                    y: { beginAtZero: true, grid: { borderDash: [4, 4], color: '#e2e8f0', drawBorder: false }, ticks: { color: '#64748b', font: { family: 'Inter' } } },
                    x: { grid: { display: false, drawBorder: false }, ticks: { color: '#64748b', font: { family: 'Inter' } } }
                }
            }
        });

        const ctxCat = document.getElementById('categoryChart').getContext('2d');
        catChartInstance = new Chart(ctxCat, {
            type: 'doughnut',
            data: {
                labels: chartData.categoryLabels,
                datasets: [{
                    data: chartData.categoryData,
                    backgroundColor: [
                        '#4f46e5', '#10b981', '#f59e0b', '#0ea5e9', 
                        '#ec4899', '#8b5cf6', '#ef4444', '#14b8a6', 
                        '#f97316', '#64748b'
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '75%',
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 20, usePointStyle: true, pointStyle: 'circle', color: '#475569', font: { family: 'Inter', size: 13, weight: '500' } } },
                    tooltip: { backgroundColor: '#1e293b', padding: 12, bodyFont: { size: 14, weight: 'bold', family: 'Inter' } }
                }
            }
        });
    }
</script>
