@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Hệ thống CMS - Dashboard";
}

<!-- Google Fonts & FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div class="dashboard-wrapper">
    <div class="container-fluid px-4 py-4">

        <!-- TOP BAR / HEADER -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar-container">
                    <img src="https://ui-avatars.com/api/?name=@(User.FindFirst("FullName")?.Value ?? "Guest")&background=6366f1&color=fff&size=100"
                         class="rounded-circle-custom" alt="Avatar">
                    <span class="status-indicator"></span>
                </div>
                <div>
                    <span class="text-uppercase tracking-wider text-muted small fw-bold">Hệ thống quản trị</span>
                    <h1 class="h2 fw-bold text-slate-800 m-0">Chào, @(User.FindFirst("FullName")?.Value ?? "Quản trị viên") 👋</h1>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a href="https://learn.microsoft.com/aspnet/core" target="_blank" class="btn btn-modern-secondary">
                    <i class="fab fa-microsoft me-2"></i> Tài liệu
                </a>
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-modern-danger">
                        <i class="fas fa-right-from-bracket me-2"></i> Đăng xuất
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-modern-primary">
                        <i class="fas fa-right-to-bracket me-2"></i> Đăng nhập
                    </a>
                }
            </div>
        </div>

        <div class="row g-4">
            <!-- LEFT COLUMN: NAVIGATION & CONTROLS -->
            <div class="col-xl-8">
                <div class="section-title-wrapper mb-3">
                    <h3 class="section-title">Trung tâm điều khiển</h3>
                    <p class="text-muted small">Phím tắt truy cập nhanh các phân hệ dữ liệu core.</p>
                </div>

                <div class="row g-3">
                    <!-- E-COMMERCE GROUP -->
                    <div class="col-md-6 col-lg-4">
                        <a asp-controller="Order" asp-action="Index" class="menu-tile tile-emerald">
                            <div class="tile-icon"><i class="fas fa-shopping-bag"></i></div>
                            <div class="tile-content">
                                <h5>Đơn hàng</h5>
                                <p>Xử lý vận chuyển & trạng thái</p>
                            </div>
                            <i class="fas fa-chevron-right tile-arrow"></i>
                        </a>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <a asp-controller="OrderDetail" asp-action="Index" class="menu-tile tile-emerald">
                            <div class="tile-icon"><i class="fas fa-receipt"></i></div>
                            <div class="tile-content">
                                <h5>Chi tiết đơn</h5>
                                <p>Xem chi tiết giỏ hàng</p>
                            </div>
                            <i class="fas fa-chevron-right tile-arrow"></i>
                        </a>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <a asp-controller="Product" asp-action="Index" class="menu-tile tile-rose">
                            <div class="tile-icon"><i class="fas fa-box"></i></div>
                            <div class="tile-content">
                                <h5>Sản phẩm</h5>
                                <p>Kho hàng & Giá bán</p>
                            </div>
                            <i class="fas fa-chevron-right tile-arrow"></i>
                        </a>
                    </div>

                    <!-- CONTENT GROUP -->
                    <div class="col-md-6 col-lg-4">
                        <a asp-controller="Post" asp-action="Index" class="menu-tile tile-indigo">
                            <div class="tile-icon"><i class="fas fa-pen-nib"></i></div>
                            <div class="tile-content">
                                <h5>Bài viết</h5>
                                <p>Tin tức & Lộ trình học</p>
                            </div>
                            <i class="fas fa-chevron-right tile-arrow"></i>
                        </a>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <a asp-controller="Category" asp-action="Index" class="menu-tile tile-indigo">
                            <div class="tile-icon"><i class="fas fa-folder-tree"></i></div>
                            <div class="tile-content">
                                <h5>Danh mục Blog</h5>
                                <p>Cấu trúc cây bài viết</p>
                            </div>
                            <i class="fas fa-chevron-right tile-arrow"></i>
                        </a>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <a asp-controller="CategoryProduct" asp-action="Index" class="menu-tile tile-rose">
                            <div class="tile-icon"><i class="fas fa-tags"></i></div>
                            <div class="tile-content">
                                <h5>Danh mục SP</h5>
                                <p>Phân loại nhóm hàng</p>
                            </div>
                            <i class="fas fa-chevron-right tile-arrow"></i>
                        </a>
                    </div>

                    <!-- USERS GROUP -->
                    <div class="col-md-6 col-lg-6">
                        <a asp-controller="User" asp-action="Index" class="menu-tile tile-amber">
                            <div class="tile-icon"><i class="fas fa-user-gear"></i></div>
                            <div class="tile-content">
                                <h5>Hệ thống Nhân sự</h5>
                                <p>Quản lý tài khoản Admin, Biên tập viên & Phân quyền thành viên nội bộ</p>
                            </div>
                            <i class="fas fa-chevron-right tile-arrow"></i>
                        </a>
                    </div>

                    <div class="col-md-6 col-lg-6">
                        <a asp-controller="Customer" asp-action="Index" class="menu-tile tile-amber">
                            <div class="tile-icon"><i class="fas fa-users"></i></div>
                            <div class="tile-content">
                                <h5>Khách hàng (End-users)</h5>
                                <p>Quản lý thông tin hồ sơ người mua hàng, lịch sử tích điểm và tương tác</p>
                            </div>
                            <i class="fas fa-chevron-right tile-arrow"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: RECENT POSTS SIDEBAR (COMPACT LIST VIEW) -->
            <div class="col-xl-4">
                <div class="sidebar-panel">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h4 class="panel-title m-0">Tin tức mới nhất</h4>
                            <small class="text-muted">Cập nhật hệ thống gần đây</small>
                        </div>
                        <a asp-controller="Post" asp-action="Index" class="btn-view-all">
                            Xem hết <i class="fas fa-arrow-right ms-1"></i>
                        </a>
                    </div>

                    <div class="post-list-stack">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model.Take(3))
                            {
                                <div class="post-compact-item">
                                    <div class="post-thumb">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/150?text=No+Cover" : item.ImageUrl)" alt="Cover">
                                    </div>
                                    <div class="post-meta-details">
                                        <span class="badge-custom">@(item.Category?.Name ?? "General")</span>
                                        <h6 class="post-title-link">
                                            <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                                        </h6>
                                        <span class="post-time">
                                            <i class="far fa-calendar-alt me-1"></i> @item.CreatedDate.ToString("dd/MM/yyyy")
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <p class="mb-0"><i class="fas fa-inbox fa-2x mb-2 d-block text-slate-300"></i>Không có bài viết mới</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    /* VARIABLES & RESET */
    :root {
        --bg-main: #f3f4f6;
        --slate-800: #1e293b;
        --slate-600: #475569;
        --slate-400: #94a3b8;
        --indigo: #6366f1;
        --indigo-soft: #e0e7ff;
        --emerald: #10b981;
        --emerald-soft: #d1fae5;
        --rose: #f43f5e;
        --rose-soft: #ffe4e6;
        --amber: #f59e0b;
        --amber-soft: #fef3c7;
    }

    body {
        background-color: var(--bg-main) !important;
        font-family: 'Inter', sans-serif;
        color: var(--slate-800);
    }

    /* TOP BAR COMPONENTS */
    .avatar-container {
        position: relative;
        display: inline-block;
    }

    .rounded-circle-custom {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        object-fit: cover;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .status-indicator {
        position: absolute;
        bottom: -2px;
        right: -2px;
        width: 14px;
        height: 14px;
        background-color: var(--emerald);
        border: 3px solid white;
        border-radius: 50%;
    }

    .tracking-wider {
        letter-spacing: 0.05em;
    }

    /* MODERN BUTTONS */
    .btn-modern-primary, .btn-modern-secondary, .btn-modern-danger {
        padding: 0.6rem 1.2rem;
        font-size: 0.9rem;
        font-weight: 500;
        border-radius: 12px;
        transition: all 0.2s ease;
        border: none;
    }

    .btn-modern-primary {
        background: var(--indigo);
        color: white;
    }

        .btn-modern-primary:hover {
            background: #4f46e5;
            color: white;
            transform: translateY(-1px);
        }

    .btn-modern-secondary {
        background: white;
        color: var(--slate-600);
        border: 1px solid #e2e8f0;
    }

        .btn-modern-secondary:hover {
            background: #f8fafc;
            color: var(--slate-800);
        }

    .btn-modern-danger {
        background: var(--rose-soft);
        color: var(--rose);
    }

        .btn-modern-danger:hover {
            background: var(--rose);
            color: white;
        }

    /* MENU TILES (BENTO LAYOUT) */
    .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--slate-800);
        margin: 0;
    }

    .menu-tile {
        display: flex;
        align-items: center;
        background: white;
        padding: 1.25rem;
        border-radius: 16px;
        text-decoration: none !important;
        color: inherit;
        border: 1px solid rgba(226, 232, 240, 0.7);
        transition: box-shadow 0.25s ease, transform 0.25s ease;
        position: relative;
    }

        .menu-tile:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.05);
        }

    .tile-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-right: 1rem;
        flex-shrink: 0;
    }

    .tile-content h5 {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.15rem;
        color: var(--slate-800);
    }

    .tile-content p {
        font-size: 0.8rem;
        color: var(--slate-400);
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .tile-arrow {
        position: absolute;
        right: 1.25rem;
        font-size: 0.8rem;
        color: var(--slate-400);
        opacity: 0;
        transition: all 0.2s ease;
    }

    .menu-tile:hover .tile-arrow {
        opacity: 1;
        transform: translateX(3px);
    }

    /* THEME COLORS FOR TILES */
    .tile-indigo .tile-icon {
        background: var(--indigo-soft);
        color: var(--indigo);
    }

    .tile-indigo:hover {
        border-color: var(--indigo);
    }

    .tile-emerald .tile-icon {
        background: var(--emerald-soft);
        color: var(--emerald);
    }

    .tile-emerald:hover {
        border-color: var(--emerald);
    }

    .tile-rose .tile-icon {
        background: var(--rose-soft);
        color: var(--rose);
    }

    .tile-rose:hover {
        border-color: var(--rose);
    }

    .tile-amber .tile-icon {
        background: var(--amber-soft);
        color: var(--amber);
    }

    .tile-amber:hover {
        border-color: var(--amber);
    }

    /* SIDEBAR PANEL (NEWS LIST) */
    .sidebar-panel {
        background: white;
        border-radius: 20px;
        padding: 1.5rem;
        border: 1px solid rgba(226, 232, 240, 0.7);
        height: 100%;
    }

    .panel-title {
        font-size: 1.1rem;
        font-weight: 700;
    }

    .btn-view-all {
        font-size: 0.85rem;
        color: var(--indigo);
        font-weight: 600;
        text-decoration: none;
    }

    .post-list-stack {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .post-compact-item {
        display: flex;
        gap: 1rem;
        align-items: center;
        padding-bottom: 1.25rem;
        border-bottom: 1px dashed #e2e8f0;
    }

        .post-compact-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .post-thumb {
        width: 70px;
        height: 70px;
        border-radius: 10px;
        overflow: hidden;
        flex-shrink: 0;
    }

        .post-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .post-meta-details {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .badge-custom {
        align-self: flex-start;
        background: #f1f5f9;
        color: var(--slate-600);
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
    }

    .post-title-link a {
        color: var(--slate-800);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
    }

        .post-title-link a:hover {
            color: var(--indigo);
        }

    .post-time {
        font-size: 0.75rem;
        color: var(--slate-400);
    }
</style>