@model IEnumerable<CMS.Data.Entities.Category>

@* @{
    ViewData["Title"] = "Quản lý danh mục";
} *@
@{
    Layout = "_LayoutAdmin";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container mt-5">

    <div class="category-card shadow-sm border-0">

        <!-- HEADER -->
        <div class="category-header">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h3 class="mb-0 text-white fw-bold">

                        <i class="fas fa-folder-open me-2"></i>

                        DANH SÁCH DANH MỤC

                    </h3>

                    <p class="text-white-50 small mb-0">
                        Quản lý phân loại bài viết và sản phẩm
                    </p>

                </div>

                <!-- CREATE BUTTON -->
                <a asp-action="Create"
                   class="btn btn-add-new">

                    <i class="fas fa-plus-circle me-1"></i>

                    Thêm danh mục

                </a>

            </div>

        </div>

        <!-- TABLE -->
        <div class="p-0">

            <table class="table table-hover mb-0 custom-category-table">

                <thead>

                    <tr>

                        <th style="width:10%" class="ps-4">
                            ID
                        </th>

                        <th style="width:30%">
                            Tên danh mục
                        </th>

                        <th style="width:40%">
                            Mô tả chi tiết
                        </th>

                        <th style="width:20%" class="text-end pe-4">
                            Thao tác
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- ID -->
                                <td class="ps-4">

                                    <span class="badge bg-light text-dark border">
                                        #@item.Id
                                    </span>

                                </td>

                                <!-- NAME -->
                                <td>

                                    <span class="fw-bold text-primary">
                                        @item.Name
                                    </span>

                                </td>

                                <!-- DESCRIPTION -->
                                <td>

                                    <span class="text-muted d-inline-block text-truncate"
                                          style="max-width: 300px;">

                                        @item.Description

                                    </span>

                                </td>

                                <!-- ACTION -->
                                <td class="text-end pe-4">

                                    <div class="btn-group">

                                        <!-- EDIT -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-warning btn-sm mx-1">

                                            <i class="fas fa-edit"></i>

                                        </a>

                                        <!-- DELETE -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm mx-1"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">

                                            <i class="fas fa-trash-alt"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4" class="text-center py-5">

                                <i class="fas fa-folder-open display-5 text-muted mb-3"></i>

                                <p class="text-muted mb-0">
                                    Chưa có danh mục nào trong hệ thống.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- FOOTER -->
        <div class="card-footer bg-white py-3 text-center border-top">

            <small class="text-muted">

                Hiển thị @Model.Count() danh mục dữ liệu

            </small>

        </div>

    </div>

</div>

<style>

    body {
        background: #111827;
    }

    /* CARD */
    .category-card {
        background: #1f2937;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid #374151;
        box-shadow: 0 20px 40px rgba(0,0,0,.35);
    }

    /* HEADER */
    .category-header {
        background: linear-gradient(135deg,#ea580c,#fb923c);
        padding: 25px 30px;
    }

        .category-header h3 {
            font-size: 28px;
            letter-spacing: 1px;
        }

        .category-header p {
            font-size: 14px;
        }

    /* BUTTON CREATE */
    .btn-add-new {
        background: white;
        color: #ea580c;
        border: none;
        border-radius: 50px;
        padding: 12px 24px;
        font-weight: 700;
        text-decoration: none;
        transition: .3s;
    }

        .btn-add-new:hover {
            background: #fff7ed;
            color: #c2410c;
            transform: translateY(-3px);
        }

    /* TABLE */
    .custom-category-table {
        margin: 0;
        color: white;
    }

        .custom-category-table thead {
            background: #111827;
        }

            .custom-category-table thead th {
                color: #9ca3af;
                border: none;
                padding: 18px;
                text-transform: uppercase;
                letter-spacing: 1px;
                font-size: 12px;
            }

        .custom-category-table td {
            padding: 18px;
            border-bottom: 1px solid #374151;
            vertical-align: middle;
        }

        .custom-category-table tbody tr {
            transition: .3s;
        }

            .custom-category-table tbody tr:hover {
                background: #2d3748;
            }

    /* ID BADGE */
    .badge {
        background: rgba(249,115,22,.15) !important;
        color: #fb923c !important;
        border: 1px solid #fb923c !important;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
    }

    /* NAME */
    .text-primary {
        color: #fb923c !important;
        font-size: 15px;
    }

    /* DESCRIPTION */
    .text-muted {
        color: #d1d5db !important;
    }

    /* EDIT BUTTON */
    .btn-outline-warning {
        border: none;
        background: rgba(245,158,11,.15);
        color: #fbbf24;
    }

        .btn-outline-warning:hover {
            background: #f59e0b;
            color: white;
        }

    /* DELETE BUTTON */
    .btn-outline-danger {
        border: none;
        background: rgba(239,68,68,.15);
        color: #ef4444;
    }

        .btn-outline-danger:hover {
            background: #ef4444;
            color: white;
        }

    .btn-group .btn {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px !important;
        transition: .3s;
    }

        .btn-group .btn:hover {
            transform: translateY(-3px);
        }

    /* FOOTER */
    .card-footer {
        background: #1f2937 !important;
        border-top: 1px solid #374151 !important;
        color: #9ca3af;
    }

    /* EMPTY */
    .display-5 {
        color: #6b7280 !important;
    }

    /* SCROLLBAR */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-thumb {
        background: #fb923c;
        border-radius: 20px;
    }
</style>