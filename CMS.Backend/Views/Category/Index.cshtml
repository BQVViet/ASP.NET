@model IEnumerable<CMS.Data.Entities.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "_LayoutAdmin"; // Hoặc tên Layout mới của bạn
}

<div class="container-fluid px-0">
    <div class="card border-0">
        <div class="card-header bg-white border-0 pt-4 pb-0">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h3 class="mb-1 fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-folder2-open text-primary"></i>
                        Danh Sách Danh Mục
                    </h3>
                    <p class="text-muted small mb-0">
                        Quản lý hệ thống cấu trúc phân loại bài viết và sản phẩm toàn sàn
                    </p>
                </div>

                <div>
                    <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle-fill"></i>
                        Thêm danh mục mới
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle custom-modern-table">
                    <thead>
                        <tr>
                            <th style="width: 10%;" class="ps-4">ID</th>
                            <th style="width: 30%;">Tên danh mục</th>
                            <th style="width: 40%;">Mô tả chi tiết</th>
                            <th style="width: 20%;" class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="modern-badge">
                                            #@item.Id
                                        </span>
                                    </td>

                                    <td>
                                        <span class="fw-semibold text-dark text-hover-primary">
                                            @item.Name
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-secondary d-inline-block text-truncate" style="max-width: 380px;">
                                            @item.Description
                                        </span>
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2 justify-content-end">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="action-btn btn-edit" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="action-btn btn-delete"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-muted opacity-50 mb-3">
                                        <i class="bi bi-folder-x" style="font-size: 3.5rem;"></i>
                                    </div>
                                    <p class="text-secondary fw-medium mb-0">
                                        Chưa có danh mục nào tồn tại trên hệ thống.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white border-top-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small fw-medium">
                Tổng số bản ghi: <strong class="text-dark">@Model.Count()</strong> danh mục
            </span>
        </div>
    </div>
</div>

<style>
    /* Loại bỏ background cũ của file view */
    body {
        background: #f1f5f9 !important;
    }

    /* Tối ưu hóa Table theo phong cách Modern Clean */
    .custom-modern-table {
        border: none !important;
        margin-bottom: 0;
    }

        .custom-modern-table thead {
            background: #f8fafc !important;
        }

            .custom-modern-table thead th {
                color: #64748b !important;
                font-size: 12px !important;
                font-weight: 600 !important;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                padding: 16px 14px !important;
                border-bottom: 1px solid #e2e8f0 !important;
            }

        .custom-modern-table tbody td {
            padding: 16px 14px !important;
            border-bottom: 1px solid #f1f5f9 !important;
            color: #334155;
        }

        .custom-modern-table tbody tr {
            transition: background-color 0.2s ease;
        }

            .custom-modern-table tbody tr:hover {
                background-color: #f8fafc !important;
            }

    /* Kiểu dáng Badge ID mới */
    .modern-badge {
        background: #e0e7ff !important;
        color: #4f46e5 !important;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        display: inline-block;
    }

    /* Custom các nút thao tác gọn gàng */
    .action-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        text-decoration: none;
        font-size: 16px;
        transition: all 0.2s ease;
        border: none;
    }

    /* Nút sửa màu xanh dương nhạt */
    .btn-edit {
        background: #eff6ff;
        color: #2563eb;
    }

        .btn-edit:hover {
            background: #2563eb;
            color: white;
            transform: translateY(-2px);
        }

    /* Nút xóa màu đỏ hồng nhạt */
    .btn-delete {
        background: #fef2f2;
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
            transform: translateY(-2px);
        }

    /* Text link hiệu ứng hover nhẹ */
    .text-hover-primary {
        transition: color 0.15s ease;
    }

        .text-hover-primary:hover {
            color: #4f46e5 !important;
        }
</style>