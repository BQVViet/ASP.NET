@model IEnumerable<CMS.Data.Entities.Post>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý bài viết";
}

<div class="container-fluid px-0">
    <div class="card border-0">
        <div class="card-header bg-white border-0 pt-4 pb-0">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h3 class="mb-1 fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-journal-text text-primary"></i>
                        Quản Lý Bài Viết
                    </h3>
                    <p class="text-muted small mb-0">
                        Hệ thống điều phối, biên tập và phân loại nội dung tin tức trên nền tảng
                    </p>
                </div>

                <div>
                    <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-plus-circle-fill"></i>
                        Thêm bài viết mới
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body px-0 pt-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle custom-modern-table">
                    <thead>
                        <tr>
                            <th style="width: 8%;" class="ps-4">Hình ảnh</th>
                            <th style="width: 32%;">Tiêu đề bài viết</th>
                            <th style="width: 15%;">Danh mục</th>
                            <th style="width: 25%;">Nội dung tóm tắt</th>
                            <th style="width: 10%;">Ngày đăng</th>
                            <th style="width: 10%;" class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="modern-thumbnail">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl)
                                                         ? "https://via.placeholder.com/120x80?text=No+Image"
                                                         : item.ImageUrl)"
                                                 alt="@item.Title" />
                                        </div>
                                    </td>

                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-dark text-decoration-none text-hover-primary line-clamp-2">
                                            @item.Title
                                        </a>
                                    </td>

                                    <td>
                                        <span class="modern-badge">
                                            @(item.Category != null ? item.Category.Name : "Không có danh mục")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-secondary d-inline-block text-truncate-custom line-clamp-2">
                                            @Html.Raw(item.Content)
                                        </span>
                                    </td>

                                    <td class="text-secondary small">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @item.CreatedDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2 justify-content-end">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="action-btn btn-view" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="action-btn btn-edit" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="action-btn btn-delete"
                                               onclick="return confirm('Chúng ta có chắc chắn muốn xóa bài viết này không?')" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted opacity-50 mb-3">
                                        <i class="bi bi-journal-x" style="font-size: 3.5rem;"></i>
                                    </div>
                                    <p class="text-secondary fw-medium mb-0">
                                        Hiện chưa có bài viết nào được đăng tải trên hệ thống.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white border-top-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small fw-medium">
                Tổng cộng: <strong class="text-dark">@(Model?.Count() ?? 0)</strong> bài viết công khai
            </span>
        </div>
    </div>
</div>

<style>
    /* Reset nền body trắng sáng sạch sẽ */
    body {
        background: #f1f5f9 !important;
    }

    /* Thiết lập cấu trúc Table Modern */
    .custom-modern-table {
        border: none !important;
        margin-bottom: 0;
    }

        .custom-modern-table thead {
            background: #f8fafc !important;
        }

            .custom-modern-table thead th {
                color: #64748b !important;
                font-size: 12px !important;
                font-weight: 600 !important;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                padding: 16px 14px !important;
                border-bottom: 1px solid #e2e8f0 !important;
            }

        .custom-modern-table tbody td {
            padding: 16px 14px !important;
            border-bottom: 1px solid #f1f5f9 !important;
            color: #334155;
        }

        .custom-modern-table tbody tr {
            transition: background-color 0.2s ease;
        }

            .custom-modern-table tbody tr:hover {
                background-color: #f8fafc !important;
            }

    /* Custom Thumbnail ảnh bài viết gọn gàng */
    .modern-thumbnail {
        width: 64px;
        height: 44px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        background: #f1f5f9;
    }

        .modern-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Kiểu dáng Badge phân loại */
    .modern-badge {
        background: #e0e7ff !important;
        color: #4f46e5 !important;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
        white-space: nowrap;
    }

    /* Hạn chế dòng chữ trong Table */
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .text-truncate-custom p,
    .text-truncate-custom div {
        margin-bottom: 0 !important;
        display: inline;
    }

    /* Thẻ điều hướng thao tác phẳng */
    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        font-size: 15px;
        transition: all 0.2s ease;
        border: none;
    }

    /* Chi tiết (Xám nhạt) */
    .btn-view {
        background: #f1f5f9;
        color: #475569;
    }

        .btn-view:hover {
            background: #475569;
            color: white;
            transform: translateY(-2px);
        }

    /* Sửa (Xanh dương) */
    .btn-edit {
        background: #eff6ff;
        color: #2563eb;
    }

        .btn-edit:hover {
            background: #2563eb;
            color: white;
            transform: translateY(-2px);
        }

    /* Xóa (Đỏ) */
    .btn-delete {
        background: #fef2f2;
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
            transform: translateY(-2px);
        }

    /* Hiệu ứng liên kết */
    .text-hover-primary {
        transition: color 0.15s ease;
    }

        .text-hover-primary:hover {
            color: #4f46e5 !important;
        }
</style>