<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Viet CMS Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --font-primary: 'Outfit', sans-serif;
            --primary-color: #6366f1; /* Soft indigo */
            --primary-soft: #eef2ff;
            --sidebar-bg: #ffffff;
            --sidebar-hover: #f8fafc;
            --sidebar-text: #64748b;
            --sidebar-text-active: #4f46e5;
            --body-bg: #f8fafc; /* Very soft light gray/blue */
            --text-main: #334155;
            --text-muted: #94a3b8;
            --border-color: #f1f5f9;
            --card-bg: #ffffff;
        }

        body {
            font-family: var(--font-primary);
            background: var(--body-bg);
            color: var(--text-main);
            overflow-x: hidden;
            margin: 0;
            padding: 0;
            font-size: 14px;
        }

        /* =================================================================
           SIDEBAR (DARK MODERN THEME)
        ==================================================================== */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 260px;
            height: 100vh;
            background: var(--sidebar-bg);
            color: var(--sidebar-text);
            padding: 0;
            overflow-y: auto;
            z-index: 1040;
            transition: transform 0.3s ease;
            box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }

        .logo-box {
            height: 60px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            background: #ffffff; /* Light header */
            border-bottom: 1px solid var(--border-color);
        }

        .logo-box h5 {
            margin: 0;
            font-weight: 700;
            color: #1e293b;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            letter-spacing: 0.5px;
        }

        .logo-box h5 i {
            color: var(--primary-color);
            font-size: 24px;
        }

        .sidebar-heading {
            font-size: 11px;
            text-transform: uppercase;
            font-weight: 600;
            color: #5c6a82;
            padding: 20px 20px 8px 20px;
            margin: 0;
            letter-spacing: 1px;
        }

        .sidebar-menu {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 0 16px;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 8px;
            color: var(--sidebar-text);
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .sidebar-menu a i {
            font-size: 1.2rem;
            color: var(--sidebar-text);
            transition: all 0.3s ease;
        }

        .sidebar-menu a:hover {
            background: var(--sidebar-hover);
            color: var(--sidebar-text-active);
        }

        .sidebar-menu a:hover i {
            color: var(--sidebar-text-active);
        }

        .sidebar-menu a.active {
            background: var(--sidebar-hover);
            color: var(--sidebar-text-active);
            position: relative;
        }

        .sidebar-menu a.active::before {
            content: '';
            position: absolute;
            left: -16px;
            top: 10%;
            height: 80%;
            width: 4px;
            background: var(--primary-color);
            border-radius: 4px;
        }

        .sidebar-menu a.active i {
            color: var(--sidebar-text-active);
        }

        /* =================================================================
           MAIN CONTENT & TOPBAR
        ==================================================================== */
        .main-content {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            height: 60px;
            background: var(--card-bg);
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0;
            transition: color 0.3s;
        }

        .menu-toggle:hover {
            color: var(--primary-color);
        }

        .global-search {
            position: relative;
            width: 300px;
        }

        .global-search i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 16px;
        }

        .global-search input {
            width: 100%;
            background: #f8fafc;
            border: 1px solid transparent;
            border-radius: 50px;
            padding: 10px 20px 10px 45px;
            font-size: 14px;
            color: var(--text-main);
            transition: all 0.3s;
        }

        .global-search input:focus {
            background: var(--card-bg);
            border-color: var(--primary-color);
            outline: 0;
            box-shadow: 0 0 0 4px var(--primary-soft);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .notification-btn {
            position: relative;
            background: #f1f5f9;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.3s;
        }

        .notification-btn:hover {
            background: #e2e8f0;
            color: var(--primary-color);
        }

        .notification-btn .badge-dot {
            position: absolute;
            top: 2px;
            right: 2px;
            width: 10px;
            height: 10px;
            background: #dc3545;
            border: 2px solid var(--card-bg);
            border-radius: 50%;
        }

        /* USER PROFILE DROPDOWN */
        .user-profile {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 8px;
            transition: background 0.2s;
        }

        .user-profile:hover {
            background: #f8fafc;
        }

        .avatar-user {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-color), #8b5cf6);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 16px;
            box-shadow: 0 4px 10px rgba(60, 80, 224, 0.2);
        }

        .user-info {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .user-info .fw-bold {
            font-size: 14px;
            color: var(--text-main);
        }

        .user-info small {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .content-wrapper {
            padding: 20px;
            flex-grow: 1;
        }

        .page-header {
            margin-bottom: 24px;
            display: flex;
            flex-direction: column;
        }

        .breadcrumb-custom {
            display: flex;
            gap: 8px;
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .breadcrumb-custom a {
            color: var(--primary-color);
            text-decoration: none;
            transition: color 0.2s;
        }

        .breadcrumb-custom a:hover {
            color: #2538a0;
        }

        .page-header h4 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
            color: var(--text-main);
        }

        /* =================================================================
           RESPONSIVE
        ==================================================================== */
        @@media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
            }
            .sidebar.show {
                transform: translateX(0);
            }
            .main-content {
                margin-left: 0;
            }
            .menu-toggle {
                display: block;
            }
            .global-search {
                display: none;
            }
            .content-wrapper {
                padding: 20px;
            }
            .topbar {
                padding: 0 20px;
            }
        }
        
        .sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(2px);
            z-index: 1035;
        }
        .sidebar-backdrop.show {
            display: block;
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: var(--body-bg);
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <div class="sidebar" id="sidebar">
        <div class="logo-box">
            <h5>XTRA ADMIN</h5>
        </div>

        <div class="sidebar-heading">Bảng điều khiển</div>
        <div class="sidebar-menu">
            <a asp-controller="Home" asp-action="Index">
                <i class="fas fa-home"></i> Tổng quan
            </a>
        </div>

        <div class="sidebar-heading">Bán hàng</div>
        <div class="sidebar-menu">
            <a asp-controller="Order" asp-action="Index">
                <i class="fas fa-shopping-cart"></i> Đơn hàng
            </a>
            <a asp-controller="Product" asp-action="Index">
                <i class="fas fa-box-open"></i> Sản phẩm
            </a>
            <a asp-controller="CategoryProduct" asp-action="Index">
                <i class="fas fa-tags"></i> Danh mục SP
            </a>
            <a asp-controller="Customer" asp-action="Index">
                <i class="fas fa-users"></i> Khách hàng
            </a>
        </div>

        <div class="sidebar-heading">Nội dung</div>
        <div class="sidebar-menu">
            <a asp-controller="Post" asp-action="Index">
                <i class="fas fa-newspaper"></i> Bài viết
            </a>
            <a asp-controller="Category" asp-action="Index">
                <i class="fas fa-folder-open"></i> Danh mục Blog
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="User" asp-action="Index">
                    <i class="fas fa-user-shield"></i> Nhân viên
                </a>
            }
        </div>
    </div>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- TOP NAVBAR -->
        <div class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div></div>
            </div>

            <div class="topbar-right">
                <button class="notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge-dot"></span>
                </button>

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <div class="user-profile" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-user">
                                @User.Identity.Name.Substring(0, 1).ToUpper()
                            </div>
                            <div class="user-info d-none d-sm-flex">
                                <span class="fw-bold">@User.FindFirst("FullName")?.Value</span>
                                <small>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                            </div>
                            <i class="fas fa-chevron-down text-muted ms-1" style="font-size: 12px;"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3" style="min-width: 200px;">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold text-dark">@User.FindFirst("FullName")?.Value</div>
                                <div class="small text-muted">@User.Identity.Name</div>
                            </li>
                            <hr class="dropdown-divider">
                            <li><a class="dropdown-item py-2 text-danger fw-medium" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt me-2"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                }
            </div>
        </div>

        <!-- PAGE CONTENT -->
        <div class="content-wrapper">
            <div class="page-header">
                <div class="breadcrumb-custom">
                    <a href="/Home/Index"><i class="fas fa-home me-1"></i> Bảng điều khiển</a> <span>/</span> Quản trị
                </div>
                <h4>@ViewData["Title"]</h4>
            </div>

            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function () {
            // Active menu state
            var currentUrl = window.location.pathname.toLowerCase();
            $('.sidebar-menu a').each(function () {
                var linkUrl = $(this).attr('href').toLowerCase();
                if (currentUrl === linkUrl || (currentUrl === '/' && linkUrl.includes('home'))) {
                    $(this).addClass('active');
                }
            });

            // Mobile sidebar toggle
            $('#menuToggle, #sidebarBackdrop').click(function() {
                $('#sidebar').toggleClass('show');
                $('#sidebarBackdrop').toggleClass('show');
            });
        });
    </script>
</body>
</html>
