<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Viet Modern Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #4f46e5, #06b6d4);
            --sidebar-bg: #f8fafc;
            --body-bg: #f1f5f9;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--body-bg);
            color: var(--text-main);
            overflow-x: hidden;
        }

        /* =================================================================
                   SIDEBAR STYLING
                ==================================================================== */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 280px;
            height: 100vh;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            padding: 20px 15px;
            overflow-y: auto;
            z-index: 1000;
        }

        /* BRAND LOGO */
        .logo-box {
            padding: 15px 10px 25px 10px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 20px;
        }

            .logo-box h3 {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 0;
                font-size: 22px;
                font-weight: 700;
                color: #4f46e5;
            }

                .logo-box h3 i {
                    width: 42px;
                    height: 42px;
                    border-radius: 12px;
                    background: var(--primary-gradient);
                    color: white;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 20px;
                    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
                }

            .logo-box p {
                margin-top: 6px;
                margin-left: 2px;
                color: var(--text-muted);
                font-size: 13px;
                font-weight: 500;
            }

        /* MENU NAVIGATION */
        .sidebar-menu {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .sidebar-menu a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 16px;
                border-radius: 12px;
                color: #475569;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .sidebar-menu a i {
                    font-size: 18px;
                    color: #94a3b8;
                    transition: color 0.25s ease;
                }

                .sidebar-menu a:hover {
                    background: #f1f5f9;
                    color: var(--text-main);
                }

                    .sidebar-menu a:hover i {
                        color: #4f46e5;
                    }

                .sidebar-menu a.active {
                    background: var(--primary-gradient);
                    color: white;
                    font-weight: 600;
                    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
                }

                    .sidebar-menu a.active i {
                        color: white;
                    }

        /* =================================================================
                   MAIN CONTENT & TOPBAR
                ==================================================================== */
        .main-content {
            margin-left: 280px;
            padding: 40px;
            min-height: 100vh;
        }

        .topbar {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            padding: 15px 30px;
            border-radius: 16px;
            margin-bottom: 35px;
            border: 1px solid rgba(255, 255, 255, 0.7);
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.03);
        }

            .topbar h4 {
                margin: 0;
                font-size: 20px;
                font-weight: 700;
                color: var(--text-main);
            }

            .topbar p {
                margin: 4px 0 0;
                color: var(--text-muted);
                font-size: 13px;
            }

        /* USER CONTENT */
        .user-info {
            line-height: 1.3;
        }

            .user-info .fw-bold {
                color: var(--text-main);
                font-size: 14px;
            }

        .avatar-user {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--primary-gradient);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

        .logout-btn {
            border: 1px solid #fee2e2;
            border-radius: 10px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 600;
            background: #fef2f2;
            color: #ef4444;
            transition: all 0.2s;
        }

            .logout-btn:hover {
                background: #ef4444;
                color: white;
                box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
            }

        /* =================================================================
                   COMPONENTS (CARD, TABLE, FORM) ĐỒNG BỘ
                ==================================================================== */
        .card {
            border: 1px solid var(--border-color);
            border-radius: 16px;
            background: white;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.02);
        }

        .card-header {
            background: white;
            border-bottom: 1px solid var(--border-color);
            padding: 20px;
            font-weight: 600;
        }

        .table {
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

            .table thead {
                background: #f8fafc;
                color: #475569;
            }

                .table thead th {
                    border-bottom: 1px solid var(--border-color);
                    padding: 14px;
                    font-size: 13px;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                }

            .table tbody td {
                padding: 14px;
                vertical-align: middle;
                font-size: 14px;
                border-bottom: 1px solid var(--border-color);
            }

            .table tbody tr:hover {
                background: #f8fafc;
            }

        /* FORM CUSTOM */
        .form-control, .form-select {
            border-radius: 10px;
            border: 1px solid #cbd5e1;
            padding: 10px 14px;
            font-size: 14px;
            color: var(--text-main);
            transition: all 0.2s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
            }

        /* MODERN UI BUTTONS */
        .btn {
            border-radius: 10px;
            padding: 9px 16px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: var(--primary-gradient);
            border: none;
            color: white;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #4338ca, #0891b2);
                color: white;
                transform: translateY(-1px);
            }

        /* CUSTOM MODERN SCROLLBAR */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="logo-box">
            <h3>
                <i class="bi bi-rocket-takeoff"></i>
                Viet Admin
            </h3>
            <p>Hệ thống quản trị số cao cấp</p>
        </div>

        <div class="sidebar-menu">
            <a asp-controller="Home" asp-action="Index">
                <i class="bi bi-columns-gap"></i> Bảng điều khiển
            </a>
            <a asp-controller="Category" asp-action="Index">
                <i class="bi bi-folder2-open"></i> Quản lý Danh mục
            </a>
            <a asp-controller="Post" asp-action="Index">
                <i class="bi bi-journal-text"></i> Quản lý Bài viết
            </a>
            <a asp-controller="User" asp-action="Index">
                <i class="bi bi-shield-lock"></i> Quản lý Thành viên
            </a>
            <a asp-controller="CategoryProduct" asp-action="Index">
                <i class="bi bi-collection"></i> Danh mục sản phẩm
            </a>
            <a asp-controller="Product" asp-action="Index">
                <i class="bi bi-box-seam"></i> Sản phẩm
            </a>
            <a asp-controller="Customer" asp-action="Index">
                <i class="bi bi-person-badge"></i> Khách hàng
            </a>
            <a asp-controller="Order" asp-action="Index">
                <i class="bi bi-bag-check"></i> Đơn hàng
            </a>
            <a asp-controller="OrderDetail" asp-action="Index">
                <i class="bi bi-receipt-cutoff"></i> Chi tiết đơn hàng
            </a>
        </div>
    </div>

    <div class="main-content">
        <div class="topbar d-flex justify-content-between align-items-center">
            <div>
                <h4>@ViewData["Title"]</h4>
                <p>Tổng quan dữ liệu thời gian thực</p>
            </div>

            <div class="d-flex align-items-center gap-3">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="user-info text-end d-none d-sm-block">
                        <div class="fw-bold">@User.FindFirst("FullName")?.Value</div>
                        <small class="text-muted">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                    </div>

                    <div class="avatar-user">
                        @User.Identity.Name.Substring(0, 1).ToUpper()
                    </div>

                    <a asp-controller="Account" asp-action="Logout" class="logout-btn text-decoration-none">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                }
            </div>
        </div>

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function () {
            var currentUrl = window.location.pathname;
            $('.sidebar-menu a').each(function () {
                var linkUrl = $(this).attr('href');
                if (currentUrl.toLowerCase() === linkUrl.toLowerCase()) {
                    $(this).addClass('active');
                }
            });
        });
    </script>
</body>
</html>