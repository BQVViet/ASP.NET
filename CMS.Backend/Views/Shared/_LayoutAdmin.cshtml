<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PhucCMS Admin</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f4f6f9;
            overflow-x: hidden;
        }

        /* =========================
               SIDEBAR
            ========================= */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 280px;
            height: 100vh;
            background: linear-gradient(180deg,#111827,#030712);
            color: white;
            padding-top: 20px;
            box-shadow: 6px 0 25px rgba(0,0,0,.4);
            overflow-y: auto;
            scrollbar-width: thin;
            scroll-behavior: auto;
        }

        /* LOGO */
        .logo-box {
            padding: 25px 20px;
            border-bottom: 1px solid rgba(255,255,255,.08);
            margin-bottom: 20px;
        }

            .logo-box h3 {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 0;
                font-size: 28px;
                font-weight: 800;
                color: white;
            }

                .logo-box h3 i {
                    width: 52px;
                    height: 52px;
                    border-radius: 14px;
                    background: linear-gradient(135deg,#fbbf24,#d97706);
                    color: #111827;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 24px;
                }

            .logo-box p {
                margin-top: 12px;
                margin-left: 64px;
                color: #d1d5db;
                font-size: 14px;
            }

        /* MENU */
        .sidebar-menu {
            padding: 0 15px;
        }

            .sidebar-menu a {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 15px 18px;
                margin-bottom: 8px;
                border-radius: 14px;
                color: #d1d5db;
                text-decoration: none;
                font-size: 15px;
                font-weight: 600;
                transition: all .3s ease;
            }

                .sidebar-menu a i {
                    font-size: 20px;
                    min-width: 25px;
                }

                .sidebar-menu a:hover {
                    background: rgba(251,191,36,.12);
                    color: #fbbf24;
                    transform: translateX(6px);
                }

                .sidebar-menu a.active {
                    background: linear-gradient(135deg,#fbbf24,#d97706);
                    color: #111827;
                    box-shadow: 0 10px 20px rgba(251,191,36,.35);
                }

        /* =========================
               MAIN CONTENT
            ========================= */
        .main-content {
            margin-left: 280px;
            padding: 30px;
        }

        /* =========================
               TOPBAR
            ========================= */
        .topbar {
            background: #ffffff;
            padding: 20px 30px;
            border-radius: 20px;
            margin-bottom: 25px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 10px 25px rgba(0,0,0,.06);
        }

            .topbar h4 {
                margin: 0;
                font-size: 24px;
                font-weight: 700;
                color: #111827;
            }

            .topbar p {
                margin: 5px 0 0;
                color: #6b7280;
            }

        /* USER */
        .user-info {
            line-height: 1.4;
        }

            .user-info .fw-bold {
                color: #111827;
                font-size: 15px;
            }

        /* AVATAR */
        .avatar-user {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg,#fbbf24,#d97706);
            color: #111827;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            font-weight: 800;
            box-shadow: 0 8px 20px rgba(251,191,36,.35);
        }

        /* LOGOUT BUTTON */
        .logout-btn {
            border: none;
            border-radius: 50px;
            padding: 10px 18px;
            font-weight: 600;
            background: linear-gradient(135deg,#dc2626,#ef4444);
            color: white;
        }

            .logout-btn:hover {
                opacity: .9;
                color: white;
            }

        /* =========================
               CARD
            ========================= */
        .card {
            border: none;
            border-radius: 20px;
            background: white;
            box-shadow: 0 10px 25px rgba(0,0,0,.06);
        }

        .card-header {
            background: white;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 700;
        }

        /* =========================
               TABLE
            ========================= */
        .table {
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 0;
        }

            .table thead {
                background: #111827;
                color: white;
            }

                .table thead th {
                    border: none;
                    padding: 15px;
                    font-weight: 600;
                }

            .table tbody td {
                padding: 15px;
                vertical-align: middle;
            }

            .table tbody tr:hover {
                background: #fef3c7;
            }

        /* =========================
               FORM
            ========================= */
        .form-control,
        .form-select {
            border-radius: 12px;
            border: 1px solid #d1d5db;
            padding: 10px 14px;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #fbbf24;
                box-shadow: 0 0 0 .2rem rgba(251,191,36,.25);
            }

        /* =========================
               BUTTON
            ========================= */
        .btn-primary {
            background: linear-gradient(135deg,#fbbf24,#d97706);
            border: none;
            color: #111827;
            font-weight: 700;
        }

            .btn-primary:hover {
                background: linear-gradient(135deg,#f59e0b,#b45309);
                color: #111827;
            }

        .btn-success {
            border: none;
        }

        .btn-danger {
            border: none;
        }

        .btn {
            border-radius: 12px;
            font-weight: 600;
        }

        /* SCROLLBAR */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: #fbbf24;
            border-radius: 20px;
        }
    </style>

</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar" >

        <div class="logo-box">

            @* <h3> *@
            @*     <i class="bi bi-speedometer2"></i> *@
            @*     VietCMS *@
            @* </h3> *@

            @* <p>Hệ thống quản trị Admin</p> *@
            <h3>
                <i class="bi bi-speedometer2"></i>
                VietCMS
            </h3>

            <p>CMS Administration Panel</p>

        </div>

        <div class="sidebar-menu">

            <a asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-house-door"></i>

                Bảng điều khiển

            </a>

            <a asp-controller="Category"
               asp-action="Index">

                <i class="bi bi-grid"></i>

                Quản lý Danh mục

            </a>

            <a asp-controller="Post"
               asp-action="Index">

                <i class="bi bi-file-earmark-text"></i>

                Quản lý Bài viết

            </a>

            <a asp-controller="User"
               asp-action="Index">

                <i class="bi bi-people"></i>

                Quản lý Thành viên

            </a>

            <a asp-controller="CategoryProduct"
               asp-action="Index">

                <i class="bi bi-tags"></i>

                Danh mục sản phẩm

            </a>

            <a asp-controller="Product"
               asp-action="Index">

                <i class="bi bi-box-seam"></i>

                Sản phẩm

            </a>

            <a asp-controller="Customer"
               asp-action="Index">

                <i class="bi bi-person-lines-fill"></i>

                Khách hàng

            </a>

            <a asp-controller="Order"
               asp-action="Index">

                <i class="bi bi-cart-check"></i>

                Đơn hàng

            </a>

            <a asp-controller="OrderDetail"
               asp-action="Index">

                <i class="bi bi-receipt"></i>

                Chi tiết đơn hàng

            </a>

        </div>

    </div>

    <!-- MAIN -->
    <div class="main-content">

        <!-- TOPBAR -->
        <div class="topbar d-flex justify-content-between align-items-center">

            <!-- LEFT -->
            <div>

                <h4>@ViewData["Title"]</h4>

                <p>Quản lý dữ liệu hệ thống CMS</p>

            </div>

            <!-- RIGHT -->
            <div class="d-flex align-items-center gap-3">

                @if (User.Identity.IsAuthenticated)
                {
                    <div class="user-info text-end">

                        <div class="fw-bold text-dark">

                            @User.FindFirst("FullName")?.Value

                        </div>

                        <small class="text-muted">

                            @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value

                        </small>

                    </div>

                    <div class="avatar-user">

                        @User.Identity.Name.Substring(0, 1).ToUpper()

                    </div>

                    <a asp-controller="Account"
                       asp-action="Logout"
                       class="btn btn-danger btn-sm logout-btn">

                        <i class="bi bi-box-arrow-right me-1"></i>

                        Đăng xuất

                    </a>
                }

            </div>

        </div>

        <!-- BODY -->
        @RenderBody()

    </div>

    <!-- SCRIPT -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>