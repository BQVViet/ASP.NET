@model CMS.Data.Entities.Customer

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm mới khách hàng";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0 rounded-4">
        
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-user-plus me-2 text-primary"></i> THÊM MỚI KHÁCH HÀNG</h6>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill fw-medium text-secondary border shadow-sm px-3">
                <i class="fas fa-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post" id="createForm">
                
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Họ tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-sm" required placeholder="Ví dụ: Nguyễn Văn A" />
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Số điện thoại <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control form-control-sm" required placeholder="Ví dụ: 09..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Email liên hệ</label>
                        <input asp-for="Email" class="form-control form-control-sm" type="email" placeholder="Ví dụ: email@gmail.com" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                        <input asp-for="Password" class="form-control form-control-sm" type="text" required placeholder="Mật khẩu cho khách đăng nhập" />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Địa chỉ chi tiết</label>
                        <textarea asp-for="Address" class="form-control form-control-sm" rows="2" placeholder="Số nhà, đường, phường, quận..."></textarea>
                    </div>
                </div>

            </form>
        </div>
        
        <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light rounded-pill fw-medium border px-4 shadow-sm text-secondary">
                Hủy bỏ
            </a>
            <button type="button" onclick="document.getElementById('createForm').submit();" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="fas fa-plus me-1"></i> Tạo khách hàng
            </button>
        </div>
    </div>
</div>

<style>
    body { background: #f8fafc; }
    .form-control-sm { padding: 0.5rem 0.75rem; font-size: 14px; border-radius: 6px; }
</style>
