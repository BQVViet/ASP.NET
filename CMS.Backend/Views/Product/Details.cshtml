@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow border-0 rounded-4">
        <div class="card-header bg-primary text-white rounded-top-4 py-2 px-3 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold"><i class="fas fa-info-circle me-2"></i> CHI TIẾT SẢN PHẨM</h6>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill shadow-sm" style="font-size: 12px;"><i class="fas fa-arrow-left me-1"></i> Quay lại</a>
        </div>
        <div class="card-body p-3 p-lg-4">
            <div class="row">
                <div class="col-md-4 text-center mb-4 mb-md-0">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/400x400?text=No+Image" : Model.ImageUrl)" 
                         class="img-fluid rounded-4 shadow-sm" style="max-height: 260px; max-width: 100%; object-fit: contain;" alt="@Model.Name" />
                </div>
                <div class="col-md-8">
                    <h4 class="fw-bold mb-2">@Model.Name</h4>
                    
                    <div class="d-flex align-items-center mb-3">
                        <span class="badge bg-primary px-2 py-1 me-3">@(Model.CategoryProduct?.Name ?? "Chưa phân loại")</span>
                        <span class="text-danger fw-bold fs-5">@Model.Price.ToString("N0") ₫</span>
                    </div>

                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <th class="text-muted ps-0" style="width: 150px;"><i class="fas fa-box me-2"></i>Tồn kho:</th>
                                <td><span class="badge bg-success">@Model.StockQuantity</span> sản phẩm</td>
                            </tr>
                            <tr>
                                <th class="text-muted ps-0"><i class="fas fa-align-left me-2"></i>Mô tả:</th>
                                <td>@Model.Description</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mt-4 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm rounded-pill px-3 text-white">
                            <i class="fas fa-edit me-1"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm rounded-pill px-3"
                           onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này không?')">
                            <i class="fas fa-trash me-1"></i> Xóa
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

