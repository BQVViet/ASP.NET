@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm mới sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-plus-circle me-2 text-primary"></i> THÊM MỚI SẢN PHẨM</h6>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill fw-medium text-secondary border shadow-sm px-3">
                <i class="fas fa-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">
                <div class="row g-4">
                    <!-- Cột trái: Thông tin cơ bản -->
                    <div class="col-md-7">
                        <div class="mb-3">
                            <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-control-sm" required />
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Giá bán (₫) <span class="text-danger">*</span></label>
                                <input asp-for="Price" type="number" class="form-control form-control-sm" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Số lượng kho <span class="text-danger">*</span></label>
                                <input asp-for="StockQuantity" type="number" class="form-control form-control-sm" required value="0" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Danh mục <span class="text-danger">*</span></label>
                            <select asp-for="CategoryProductId" asp-items="ViewBag.CategoryList" class="form-select form-select-sm" required>
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Mô tả chi tiết</label>
                            <textarea asp-for="Description" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                    </div>

                    <!-- Cột phải: Hình ảnh & Action -->
                    <div class="col-md-5 border-start">
                        <div class="d-flex gap-3 mb-3 align-items-center bg-light p-2 rounded">
                            <img id="previewImage" src="https://via.placeholder.com/100?text=Preview" 
                                 class="rounded border" style="width: 60px; height: 60px; object-fit: cover; background: #fff;" />
                            <div style="font-size: 12px; color: #64748b;">Ảnh xem trước</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Tải ảnh lên (Từ máy tính)</label>
                            <input type="file" name="uploadImage" class="form-control form-control-sm" />
                        </div>

                        <div class="text-center my-2 text-muted" style="font-size: 12px;">- HOẶC -</div>

                        <div class="mb-4">
                            <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Dán Link ảnh (URL)</label>
                            <input asp-for="ImageUrl" id="ImageUrl" class="form-control form-control-sm" placeholder="https://..." />
                            <small class="text-muted" style="font-size: 11px;">Nếu bạn dán link, vui lòng bỏ trống phần Tải ảnh lên.</small>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light rounded-pill fw-medium border px-4 shadow-sm text-secondary">
                Hủy bỏ
            </a>
            <button type="button" onclick="document.getElementById('createForm').submit();" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="fas fa-save me-1"></i> Lưu sản phẩm
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const urlInput = document.getElementById('ImageUrl');
        const previewImg = document.getElementById('previewImage');
        
        if(urlInput && previewImg) {
            urlInput.addEventListener('input', function() {
                const url = this.value.trim();
                if(url) {
                    previewImg.src = url;
                } else {
                    previewImg.src = "https://via.placeholder.com/100?text=Preview";
                }
            });
        }
    });
</script>
