@model CMS.Data.Entities.User

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm thành viên";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0 rounded-4">
        
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-user-plus me-2 text-primary"></i> THÊM THÀNH VIÊN HỆ THỐNG</h6>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill fw-medium text-secondary border shadow-sm px-3">
                <i class="fas fa-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post" id="createForm">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Username <span class="text-danger">*</span></label>
                        <input asp-for="UserName" class="form-control form-control-sm" required placeholder="Tên đăng nhập..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Mật khẩu <span class="text-danger">*</span></label>
                        <input asp-for="PasswordHash" type="password" class="form-control form-control-sm" required placeholder="Mật khẩu an toàn..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control form-control-sm" required placeholder="Tên hiển thị..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-medium text-secondary" style="font-size: 13px;">Vai trò hệ thống <span class="text-danger">*</span></label>
                        <select asp-for="Role" class="form-select form-select-sm" required>
                            <option value="">-- Chọn quyền --</option>
                            <option value="Admin">Admin</option>
                            <option value="Editor">Editor</option>
                            <option value="User">User</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>

        <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light rounded-pill fw-medium border px-4 shadow-sm text-secondary">
                Hủy bỏ
            </a>
            <button type="button" onclick="document.getElementById('createForm').submit();" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="fas fa-plus me-1"></i> Lưu thành viên
            </button>
        </div>
    </div>
</div>

<style>
    body { background: #f8fafc; }
    .form-control-sm { padding: 0.5rem 0.75rem; font-size: 14px; border-radius: 6px; }
</style>
