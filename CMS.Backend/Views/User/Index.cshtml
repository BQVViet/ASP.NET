@model IEnumerable<CMS.Data.Entities.User>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản trị thành viên";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container mt-5">

    <div class="user-management-card shadow-lg border-0">

        <!-- HEADER -->
        <div class="card-header-custom">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <h2 class="mb-0 text-white text-uppercase fw-bold">

                        <i class="fas fa-users-cog me-2"></i>

                        Quản trị hệ thống

                    </h2>

                    <small class="text-white-50">

                        Tổng cộng @(Model?.Count() ?? 0) thành viên

                    </small>

                </div>

                <!-- CREATE BUTTON -->
                <a asp-action="Create"
                   class="btn btn-light btn-sm fw-bold shadow-sm">

                    <i class="fas fa-user-plus me-1"></i>

                    Thêm mới

                </a>

            </div>

        </div>

        <!-- TABLE -->
        <div class="table-responsive p-4">

            <table class="table table-hover align-middle custom-table">

                <thead>

                    <tr>

                        <th class="text-center">ID</th>

                        <th>Tài khoản</th>

                        <th>Họ và tên</th>

                        <th class="text-center">Vai trò</th>

                        <th class="text-end">Hành động</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            var firstChar = !string.IsNullOrEmpty(user.UserName)
                            ? user.UserName.Substring(0, 1).ToUpper()
                            : "?";

                            bool isAdmin =
                            user.Role != null &&
                            (user.Role.Contains("Admin") ||
                            user.Role.Contains("Quản"));

                            <tr>

                                <!-- ID -->
                                <td class="text-center fw-bold text-muted">
                                    #@user.Id

                                </td>
                                <!-- USERNAME -->
                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="avatar-circle me-3">

                                            @firstChar

                                        </div>

                                        <div>

                                            <div class="fw-semibold">

                                                @user.UserName

                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <!-- FULLNAME -->
                                <td>

                                    @user.FullName

                                </td>

                                <!-- ROLE -->
                                <td class="text-center">
                                    <span class="badge-custom @(isAdmin ? "badge-admin" : "badge-editor")">
                                        <i class="fas @(isAdmin ? "fa-shield-halved" : "fa-user") me-1"></i>
                                        @user.Role
                                    </span>
                                </td>
                                <!-- ACTION -->
                                <td class="text-end">

                                    <!-- EDIT -->
                                    <a asp-action="Edit"
                                       asp-route-id="@user.Id"
                                       class="btn btn-action btn-edit me-1"
                                       title="Sửa">

                                        <i class="fas fa-edit"></i>

                                    </a>

                                    <!-- DELETE -->
                                    <a asp-action="Delete"
                                       asp-route-id="@user.Id"
                                       class="btn btn-action btn-delete"
                                       title="Xóa"
                                       onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @user.UserName không?')">

                                        <i class="fas fa-trash"></i>

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center py-5 text-muted">

                                <i class="fas fa-users-slash fs-1 d-block mb-3"></i>

                                Chưa có thành viên nào

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<style>

    :root {
        --gold: #d4af37;
        --gold-light: #f4d03f;
        --dark: #111827;
        --dark-card: #1f2937;
        --border: #374151;
    }

    body {
        background: #0f172a;
    }

    /* CARD */
    .user-management-card {
        background: var(--dark-card);
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid var(--border);
        box-shadow: 0 20px 40px rgba(0,0,0,.35);
    }

    /* HEADER */
    .card-header-custom {
        background: linear-gradient( 135deg, #b8860b, #f4d03f );
        padding: 24px 30px;
    }

        .card-header-custom h3,
        .card-header-custom h4,
        .card-header-custom h5 {
            color: white;
            font-weight: 700;
            margin: 0;
        }

    /* TABLE */
    .custom-table {
        margin-bottom: 0;
        color: white;
    }

        .custom-table thead th {
            background: #111827;
            color: #d4af37;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 12px;
            border: none;
            padding: 18px;
        }

        .custom-table td {
            padding: 18px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .custom-table tbody tr {
            transition: .3s;
        }

            .custom-table tbody tr:hover {
                background: #2a3441;
            }

    /* AVATAR */
    .avatar-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(212,175,55,.15);
        color: var(--gold);
        border: 2px solid rgba(212,175,55,.3);
        font-weight: bold;
        font-size: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* BADGE */
    .badge-custom {
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 700;
    }

    .badge-admin {
        background: rgba(239,68,68,.15);
        color: #ef4444;
        border: 1px solid rgba(239,68,68,.3);
    }

    .badge-editor {
        background: rgba(212,175,55,.15);
        color: var(--gold);
        border: 1px solid rgba(212,175,55,.3);
    }

    /* ACTION BUTTON */
    .btn-action {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        border: none;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        transition: .3s;
        text-decoration: none;
    }

    /* EDIT */
    .btn-edit {
        background: rgba(212,175,55,.15);
        color: var(--gold);
    }

        .btn-edit:hover {
            background: var(--gold);
            color: #111827;
            transform: translateY(-3px);
        }

    /* DELETE */
    .btn-delete {
        background: rgba(239,68,68,.15);
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #ef4444;
            color: white;
            transform: translateY(-3px);
        }

    /* BUTTON ADD */
    .btn-add-user {
        background: var(--gold);
        color: #111827;
        border: none;
        border-radius: 50px;
        padding: 12px 24px;
        font-weight: 700;
        transition: .3s;
    }

        .btn-add-user:hover {
            background: var(--gold-light);
            transform: translateY(-2px);
        }

    /* TEXT */
    .text-muted {
        color: #9ca3af !important;
    }

    /* SCROLLBAR */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-thumb {
        background: var(--gold);
        border-radius: 20px;
    }
</style>