@model IEnumerable<CMS.Data.Entities.User>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản trị thành viên";
}

<div class="container-fluid px-0 mt-4">
    <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden;">
        <!-- Solid Blue Header -->
        <div class="card-header bg-primary text-white border-0 py-4 px-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="mb-2 fw-bold text-white d-flex align-items-center gap-2 m-0" style="font-size: 1.8rem;">
                    <i class="bi bi-people-fill"></i> Danh Sách Thành Viên
                </h2>
                <p class="mb-0" style="color: rgba(255,255,255,0.7); font-size: 0.95rem;">
                    Tổng cộng @(Model?.Count() ?? 0) thành viên
                </p>
            </div>

            <div>
                <a asp-action="Create" class="btn btn-light rounded-pill px-4 py-2 fw-bold text-dark d-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-person-plus-fill"></i> Thêm thành viên
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive bg-white">
                <table class="table table-hover align-middle custom-admin-table mb-0">
                    <thead>
                        <tr>
                            <th style="width: 10%;" class="ps-4 text-center">ID</th>
                            <th style="width: 30%;">TÀI KHOẢN</th>
                            <th style="width: 25%;">HỌ VÀ TÊN</th>
                            <th style="width: 20%;" class="text-center">VAI TRÒ</th>
                            <th style="width: 15%;" class="text-center pe-4">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                var firstChar = !string.IsNullOrEmpty(user.UserName)
                                ? user.UserName.Substring(0, 1).ToUpper()
                                : "?";

                                bool isAdmin = user.Role != null &&
                                (user.Role.Contains("Admin") || user.Role.Contains("Quản"));

                                <tr>
                                    <td class="ps-4 py-3 fw-bold text-secondary text-center">
                                        #@user.Id
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-circle">
                                                @firstChar
                                            </div>
                                            <span class="text-dark fw-medium" style="font-size: 0.95rem;">@user.UserName</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-dark" style="font-size: 0.95rem;">
                                            @user.FullName
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <span class="modern-role-badge @(isAdmin ? "role-admin" : "role-editor")">
                                            <i class="bi @(isAdmin ? "bi-shield-check" : "bi-person") me-1"></i>
                                            @user.Role
                                        </span>
                                    </td>

                                    <td class="text-center pe-4">
                                        <div class="d-inline-flex gap-2 justify-content-center">
                                            <a asp-action="Edit" asp-route-id="@user.Id"
                                               class="btn-action edit" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@user.Id"
                                               class="btn-action delete"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @user.UserName không?')" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <p class="text-secondary fw-medium mb-0">
                                        Hệ thống chưa có tài khoản thành viên nào.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background: #f1f5f9 !important;
    }

    /* Thiết lập cấu trúc Table giống ảnh */
    .custom-admin-table {
        border: none !important;
    }

        .custom-admin-table thead {
            background: #fafafa !important;
        }

            .custom-admin-table thead th {
                color: #4f46e5 !important;
                font-size: 13px !important;
                font-weight: 700 !important;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                padding: 18px 14px !important;
                border-bottom: 1px solid #e2e8f0 !important;
            }

        .custom-admin-table tbody td {
            padding: 16px 14px !important;
            border-bottom: 1px solid #f1f5f9 !important;
            vertical-align: middle;
        }

        .custom-admin-table tbody tr {
            transition: background-color 0.2s ease;
        }

            .custom-admin-table tbody tr:hover {
                background-color: #f8fafc !important;
            }

    /* Avatar tròn nhỏ như ảnh */
    .avatar-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #e2e8f0;
        color: #3b82f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 14px;
    }

    /* Nút Thêm màu trắng */
    .btn-light {
        background-color: #ffffff;
        border-color: #ffffff;
        color: #0f172a;
    }

    .btn-light:hover {
        background-color: #f8fafc;
        color: #0f172a;
    }

    /* Modern Role Badge */
    .modern-role-badge {
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
    }

    .role-admin {
        background: #fff5f5;
        color: #e53e3e;
        border: 1px solid #fed7d7;
    }

    .role-editor {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #dcfce7;
    }

    /* Nút thao tác chuyên nghiệp Minimalist */
    .btn-action {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: transparent;
        border: 1px solid transparent;
        color: #94a3b8;
        transition: all 0.2s ease;
        font-size: 15px;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-action:hover {
        background: #f8fafc;
        border-color: #e2e8f0;
        color: #0f172a;
    }

    .btn-action.view:hover {
        background: #f0fdf4;
        border-color: #bbf7d0;
        color: #16a34a;
    }

    .btn-action.edit:hover {
        background: #eff6ff;
        border-color: #bfdbfe;
        color: #2563eb;
    }

    .btn-action.delete:hover {
        background: #fef2f2;
        border-color: #fecaca;
        color: #dc2626;
    }
</style>
