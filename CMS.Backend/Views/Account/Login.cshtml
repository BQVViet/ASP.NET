@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Đăng nhập hệ thống - XTRA ADMIN</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #334155;
            --text-muted: #94a3b8;
            --border-color: #e2e8f0;
        }

        body {
            margin: 0;
            height: 100vh;
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Outfit', sans-serif;
            color: var(--text-main);
        }

        .login-wrapper {
            width: 100%;
            max-width: 440px;
            padding: 20px;
        }

        .login-box {
            background: var(--card-bg);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0,0,0,0.05);
            border: 1px solid rgba(255, 255, 255, 0.5);
            padding: 40px 40px 30px 40px;
        }

        .login-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .icon-box {
            width: 64px;
            height: 64px;
            background: #eef2ff;
            color: var(--primary);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin: 0 auto 20px auto;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.1);
        }

        .login-header h3 {
            margin: 0 0 8px 0;
            font-weight: 700;
            color: #1e293b;
            font-size: 24px;
            letter-spacing: -0.5px;
        }
        
        .login-header p {
            color: var(--text-muted);
            margin: 0;
            font-size: 14px;
        }

        .form-label {
            font-weight: 500;
            font-size: 14px;
            color: #475569;
            margin-bottom: 8px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 24px;
        }

        .input-group-custom i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 16px;
            transition: color 0.3s;
        }

        .form-control {
            height: 52px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            background: #f8fafc;
            padding-left: 45px;
            font-size: 15px;
            font-weight: 500;
            color: var(--text-main);
            transition: all 0.3s;
        }

        .form-control:focus {
            background: #ffffff;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .form-control:focus + i, .input-group-custom:focus-within i {
            color: var(--primary);
        }

        .btn-login {
            height: 52px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            background: var(--primary);
            border: none;
            box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
            transition: all 0.3s;
            margin-top: 10px;
        }

        .btn-login:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(99, 102, 241, 0.3);
        }

        .alert-danger {
            background: #fef2f2;
            color: #ef4444;
            border: 1px solid #fee2e2;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            padding: 12px 16px;
        }

        .footer-text {
            text-align: center;
            color: var(--text-muted);
            margin-top: 30px;
            font-size: 13px;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="login-box">

            <div class="login-header">
                <div class="icon-box">
                    <i class="fas fa-cube"></i>
                </div>
                <h3>XTRA ADMIN</h3>
                <p>Đăng nhập để vào hệ thống quản trị</p>
            </div>

            <form asp-action="Login" method="post">

                <div class="input-group-custom">
                    <label class="form-label">Tên đăng nhập</label>
                    <div style="position: relative;">
                        <input type="text"
                               name="username"
                               class="form-control"
                               placeholder="VD: admin"
                               required />
                        <i class="fas fa-user"></i>
                    </div>
                </div>

                <div class="input-group-custom">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Mật khẩu</label>
                    </div>
                    <div style="position: relative;">
                        <input type="password"
                               name="password"
                               class="form-control"
                               placeholder="Nhập mật khẩu"
                               required />
                        <i class="fas fa-lock"></i>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mb-4">
                        <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Error
                    </div>
                }

                <button type="submit" class="btn btn-primary btn-login w-100">
                    Đăng nhập ngay <i class="fas fa-arrow-right ms-2"></i>
                </button>

            </form>

        </div>
        
        <div class="footer-text">
            © 2025 Viet CMS - Thiết kế bởi đội ngũ
        </div>
    </div>

</body>
</html>
