@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>CMS Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            height: 100vh;
            background: linear-gradient(135deg, #1e3c72, #2a5298);
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-box {
            width: 420px;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        }

        .login-header {
            text-align: center;
            padding: 35px 20px;
            background: #0d6efd;
            color: white;
        }

            .login-header img {
                width: 70px;
                margin-bottom: 10px;
            }

            .login-header h3 {
                margin: 0;
                font-weight: 600;
            }

        .login-body {
            padding: 35px;
        }

        .form-control {
            height: 50px;
            border-radius: 12px;
        }

        .btn-login {
            height: 50px;
            border-radius: 12px;
            font-size: 18px;
            font-weight: 600;
        }

        .footer-text {
            text-align: center;
            color: gray;
            margin-top: 20px;
            font-size: 14px;
        }

        .icon-box {
            text-align: center;
            margin-top: -45px;
        }

            .icon-box div {
                width: 90px;
                height: 90px;
                background: white;
                border-radius: 50%;
                margin: auto;
                line-height: 90px;
                font-size: 40px;
                box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            }
    </style>
</head>
<body>

    <div class="login-box">

        <div class="login-header">
            <h3>VIET CMS</h3>
            @* <p class="mb-0">Hệ Thống Quản Trị Nội Dung</p> *@
        </div>

        <div class="icon-box">
            <div>👤</div>
        </div>

        <div class="login-body">

            <form asp-action="Login" method="post">

                <div class="mb-3">
                    <label class="form-label">Tên đăng nhập</label>
                    <input type="text"
                           name="username"
                           class="form-control"
                           placeholder="Nhập tên đăng nhập"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password"
                           name="password"
                           class="form-control"
                           placeholder="Nhập mật khẩu"
                           required />
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <button type="submit"
                        class="btn btn-primary btn-login w-100">
                    ĐĂNG NHẬP
                </button>

            </form>

            <div class="footer-text">
                © 2025 CMS Management System
            </div>

        </div>

    </div>

</body>
</html>