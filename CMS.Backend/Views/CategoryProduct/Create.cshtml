@model CMS.Data.Entities.CategoryProduct

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm Danh Mục Sản Phẩm Mới";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0 rounded-4">
        
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-folder-plus me-2 text-primary"></i> THÊM DANH MỤC SẢN PHẨM MỚI</h6>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill fw-medium text-secondary border shadow-sm px-3">
                <i class="fas fa-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post" id="createForm">
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-medium text-secondary" style="font-size: 13px;">Tên danh mục <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control form-control-sm" placeholder="Nhập tên danh mục..." required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-medium text-secondary" style="font-size: 13px;">Mô tả</label>
                    <textarea asp-for="Description" class="form-control form-control-sm" rows="3" placeholder="Nhập mô tả danh mục..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </form>
        </div>

        <div class="card-footer bg-light border-top py-3 px-4 d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-light rounded-pill fw-medium border px-4 shadow-sm text-secondary">
                Hủy bỏ
            </a>
            <button type="button" onclick="document.getElementById('createForm').submit();" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="fas fa-plus me-1"></i> Thêm mới
            </button>
        </div>
    </div>
</div>

<style>
    body { background: #f8fafc; }
    .form-control-sm { padding: 0.5rem 0.75rem; font-size: 14px; border-radius: 6px; }
</style>
